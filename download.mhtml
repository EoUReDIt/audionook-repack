@charset "utf-8";

html:not(.boot-done) { background: rgb(12, 13, 17); }

html:not(.boot-done) body { margin: 0px; background: rgb(12, 13, 17); }

html[data-theme=3D"light"]:not(.boot-done), html[data-theme=3D"light"]:not(=
.boot-done) body { background: rgb(247, 244, 238); }

html[data-theme=3D"black"]:not(.boot-done), html[data-theme=3D"black"]:not(=
.boot-done) body { background: rgb(0, 0, 0); }

html:not(.boot-done) #app, html:not(.boot-done) #miniPlayer, html:not(.boot=
-done) #playerScreen, html:not(.boot-done) #modalRoot, html:not(.boot-done)=
 #toastRoot { visibility: hidden; }

#bootCover { position: fixed; inset: 0px; z-index: 99999; display: flex; fl=
ex-direction: column; align-items: center; justify-content: center; gap: 22=
px; background: rgb(12, 13, 17); color: rgb(240, 166, 60); font-family: Int=
er, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue"=
, Arial, sans-serif; opacity: 1; transition: opacity 0.35s; }

html[data-theme=3D"light"] #bootCover { background: rgb(247, 244, 238); col=
or: rgb(207, 122, 28); }

html[data-theme=3D"black"] #bootCover { background: rgb(0, 0, 0); }

#bootCover.bc-out { opacity: 0; pointer-events: none; }

#bootCover .bc-mark { display: block; width: 46px; height: 46px; }

#bootCover .bc-name { display: block; font-family: Fraunces, Georgia, "Time=
s New Roman", serif; font-size: 21px; font-weight: 600; letter-spacing: 0.0=
1em; color: rgb(245, 242, 234); margin-top: -6px; }

html[data-theme=3D"light"] #bootCover .bc-name { color: rgb(30, 27, 22); }

#bootCover .bc-spin { width: 30px; height: 30px; border-radius: 50%; border=
-width: 3px; border-style: solid; border-color: transparent currentcolor cu=
rrentcolor; border-image: none; opacity: 0.95; animation: 0.7s linear 0s in=
finite normal none running bc-spin; }

@keyframes bc-spin {=20
  100% { transform: rotate(360deg); }
}

@media (prefers-reduced-motion: reduce) {
  #bootCover .bc-spin { animation-duration: 1.6s; }
}
