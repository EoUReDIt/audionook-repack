{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audionook",
  "version": "0.1.0",
  "identifier": "io.github.eouredit.audionook",
  "build": {
    "frontendDist": "../app",
    "beforeBuildCommand": "npm run vendor"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Audionook",
        "width": 1240,
        "height": 840,
        "minWidth": 420,
        "minHeight": 560,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Turn text and documents into audiobooks",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
